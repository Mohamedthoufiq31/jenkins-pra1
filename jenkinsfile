pipeline {
    agent any

    stages {
        stage('Build & Test') {
            steps {
                echo 'Running build processes...'
                // If this step fails, the pipeline skips straight to the post section
                sh 'make test' 
            }
        }
    }

    /* The post section handles actions at the very end of the run */
    post {
        always {
            echo 'The pipeline has completed, running final cleanup tasks...'
            deleteDir() // Cleans up the workspace directory
        }
        success {
            echo 'The build was successful!'
        }
        failure {
            echo 'The build failed. Investigating logs...'
        }
    }
}
