pipeline {
    agent any

    stages {

        stage('Checkout Verification') {
            steps {
                echo 'Checking Jenkins workspace...'
                sh 'pwd'
                sh 'ls -la'
            }
        }

        stage('Build') {
            steps {
                echo 'Building application'
            }
        }

        stage('Test') {
            steps {
                echo 'Testing application'
            }
        }
    }
}