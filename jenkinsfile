pipeline {
    agent any

    stages {

        stage('Build') {
            steps {
                echo '===== BUILD ====='
                echo 'Building application'
            }
        }

        stage('Test') {
            steps {
                echo '===== TEST ====='
                echo 'Testing application'
            }
        }

        stage('Deploy') {
            steps {
                echo '===== DEPLOY ====='
                echo 'Deploying application'
            }
        }
    }

    post {

        success {
            echo '===== SUCCESS ====='
            echo 'Application deployment successful'
        }

        failure {
            echo '===== FAILURE ====='
            echo 'Application deployment failed'
        }

        always {
            echo '===== ALWAYS ====='
            echo 'Pipeline execution completed'
        }
    }
}